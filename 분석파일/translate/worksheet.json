[
{
"kind": "desc",
"src": "experimental_mods/Debugging/ResetEventFlags.json",
"en": "Reset chapter-dependent event flags every time\nthe Intermission is saved and reloaded,\nand set them to true.\n\nWARNING: This will remove characters from the\nroster that are obtained by hitting certain\nevent flags, like on-field Akyu/Lily Black/classic\nReimu & Marisa. Please be cautious when utilizing\nthis mod to test event flags by chapter.",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Audio/ChangeIntermissionBGM.json",
"en": "Change the BGM that plays \nduring the Intermission\nInput the internal name of the song \nexcluding the loop point \nReload your saves to apply BGM changes \nRequires the EnableLayeredFS mod to be active\n\n(Default internal name is bgm_gen_intermission2)",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Audio/DisableLvlUpJingle.json",
"en": "Disable level up jingle SE",
"ko": ""
},
{
"kind": "desc",
"src": "mods/BugFixes/BarrierAnimationFix.json",
"en": "Fix file wildcard matching and unit_code/char_code\nmismatches causing the game to display barriers\nincorrectly for certain units.\n\nRecommended to be enabled alongside\ngraphic files loaded through LayeredFS\n\nDisable this mod if barrier graphics are not\nappearing for certain units",
"ko": ""
},
{
"kind": "desc",
"src": "mods/BugFixes/CombInfiniteFix.json",
"en": "Fix infinite turns bug with combined units \nby tracking turn count between \nsplitting and recombining\nMay not be stable if toggled repeatedly \nbetween turns throughout a chapter",
"ko": ""
},
{
"kind": "desc",
"src": "mods/BugFixes/DialogFixForForms.json",
"en": "Fix dialog bug where\nKeine's/Byakuren's/Lily White's UnitID\nis displayed in text scripts\ninstead of their typical name",
"ko": ""
},
{
"kind": "desc",
"src": "mods/BugFixes/FixSpiritChoreography.json",
"en": "Fix choreography for spirit animations to match up\nwith SE at original 1x frame speed.\nSpeed up will still play at CB's default 1.5x\nspeed to not compromise gameplay speed",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Debugging/DisplayInternalName.json",
"en": "Display internal unit_data/character_data IDs \nin unit/character status screens",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Debugging/EnableDebugMenu.json",
"en": "Enable Debug Menu\n\nNOTE: Make frequent backup saves.\nThe Debug Menu may not be fully stable when\nmodifying in-game save values and may crash.\nAdditionally, certain Debug Menu actions like the\nChapter Select may irreversibly modify your units;\nplease be cautious when using this tool.",
"ko": ""
},
{
"kind": "desc",
"src": "mods/FileSystem/EnableLayeredFS.json",
"en": "Enable custom loading of data file resources \nfrom modData folder\n\nSome updates to data files require \nrestarting the game",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/AceKillBonus.json",
"en": "Restore +5 initial Power bonus for 50 kills\nand #1 Ace kills",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/DisableBattleInfoSpirits.json",
"en": "Disable casting spirits in the Battle Info screen",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/FMW4SPMechanics.json",
"en": "Restore FMW4 SP mechanics\n- SP Regen skill only works in 1st 10 turns\n- Disable universal +10 SP Regen\n- SP is not initially halved\n- Regen text is updated to account for changes\nReload saves to update SP mechanics \non various screens",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/FMW4SongMechanics.json",
"en": "Restore Mystia's Song mechanics from FMW4\nNOTE: FMW4 song buffs are limited to \n1 type active at a time.\nFuture songs will overwrite the previous buff, \nif applicable.\nSong effects below (w/o Valor/Songstress boost)\n\n\n\n\n\n- SotnS: Accuracy/Evade stats +30\n-- MAP: Centered-radius, targets Team\nAccuracy/Evade +20\n- HotHO: Defense stat +30/Skill stat +15 \n-- MAP: Centered-radius, Defense +20/Skill +10 \n- MCM: Cqb/Range/Accuracy stats +40 \n-- MAP: Centered-radius\nCqb/Range/Accuracy +20",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/MoveAirMPCost.json",
"en": "Restore MP cost for movement in Air Terrain\nThe Shimenawa regains its original effect\nto nullify MP cost for movement in Air",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/NullifyBunshinGraze.json",
"en": "Nullify Graze damage when Bunshin\nor similar effects activate, mirroring the mechanic\nin FMW1",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/Restore1.0AssistPenalty.json",
"en": "Restore 0.70x assist attack penalty for 1.0 cost\nunits, matching the behavior back in FMW4",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/RestoreEnemyCrit.json",
"en": "Restore the ability for enemies to deal critical hits\nAdditionally, revert to OG FMW crit calculations\nwhere final enemy critical rate is halved",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/RestoreRevengeStorage.json",
"en": "Restore the Revenge Storage mechanic\npresent in the original games.\nThe Revenge damage multiplier can be retained\non a frontline unit as long as the unit avoids\nattacking. This also applies to Support Attacks.\n\nNOTE: Suspend Saves do not track\nstored Revenge multipliers; stored revenge boosts\nwill be wiped after reloading\n\n\nAdditionally, the Revenge multiplier will now show\nin the damage calculation if the stored\nRevenge boost is greater than 0",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/SwitchBarrierMode.json",
"en": "Input 0 or 1 to modify barrier behavior\nduring Graze.\nModes:\n- Default (0): Barriers can activate and consume\nMP in all calculated damage scenarios\nincluding Graze, Hit, and Defend\n- OG FMW (1): Barriers only activate and consume\nMP on Hit and Defend\n\n\n\n\nThe projected barrier sprite in the Battle Info\nscreen only appears when the unit's barrier can\nsuccessfully nullify/reduce damage,\nwith the projection assuming the unit is unfocused.\nWhen selecting the OG FMW option,\nbe wary when barriers do not activate during Graze",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Mechanics/TriggerPersistGraze.json",
"en": "Restore functionality for the Persist (Grit) spirit\nto trigger on Graze",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Modifiers/BreakTakemikazuchiLimit.json",
"en": "This divine lightning shall pierce the skies!\n\n(Remove the exponential damage cap from \nplayer Yorihime's Takemikazuchi \nand set formula to Normal+ and above \nenemy version)",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Modifiers/DeploymentCost.json",
"en": "Modify deployment cost \n(Set to -1 for default cost)\n(Set to 500 or higher for infinite cost)\nMin:-1, Max:999\nReload your saves for the updated cost to apply.",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Modifiers/EnableAllSecretUnits.json",
"en": "Set all event flags to true to unlock Lily Black,\non-field Akyu, and the classic forms\nfor Reimu and Marisa\n\nTurn the mod on and you will always play out\nthese secret unit events regardless\nof any other circumstances\nDisable the mod to return to the default behavior\nfor checking these event flags",
"ko": ""
},
{
"kind": "desc",
"src": "mods/Modifiers/EnableAllUnitsNG+.json",
