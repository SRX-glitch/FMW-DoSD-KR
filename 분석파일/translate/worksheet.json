},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...You don't talk like a stereotypical Chinese!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...Ehehe!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...The little sister character!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...I'm your big bro!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...You little devil!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...Sidelong glances belong to you!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...Which ears are the real ones!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...A succubus is fine too!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Evileye/dialog_text_Evileye_en/EvileyeFMW1Text.json",
"en": "...When's your crouching block coming!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "I'll rip you to shreds!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "Ehehe... Gotcha.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "Smash!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "You can't run from me.",
"ko": "내게서 도망칠 수는 없어!"
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "See... I caught you.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "Break!",
"ko": "파!"
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "All right, I have you cornered now!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "Hehe... Are you ready?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "Disappear!",
"ko": "사라져 버려!!"
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "I'll smash you up... all of you.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "You're all out of line!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Flan/dialog_text_Flan/ScarletFOKText.json",
"en": "You're scared of me, I know!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Let's go!",
"ko": "간다아─!"
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I... have come!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Everyone only cares about the war!\nWhy doesn't anyone want to understand each other!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I will... I will protect everyone!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I have something I want to protect, so I will fight!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Dad, Mom... Watch over me!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I'm still alive! I can still fight!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "The pain is nothing compared to her tears...!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I saw her just now... Was she... crying...?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I'm feeling great! I'm charging in!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I'll say a prayer for you.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Your fate has been sealed.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Feel the difference in power between us!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Energy charged 100%... Commence assault!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I'm gonna tear a hole in your body!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Take thiiiiis!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Jumping in front of me without practice!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Ahh, geez!\nIf you don't understand, I'm going to make you!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Wahhhh! My body's heating up!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I'll make it painless for you.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I keep telling you not to go too far ahead!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Heh heh... You're a cute one, li'l missy.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Guess I'm accompanying you to the depths of Hell.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "There, there, theeere!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Don't hate me for this, but I'll have to shoot you down.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You think you can keep track of all my bullets!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You... You fool!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "If shooting you down will end the war... I'll do it!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Hit, hit! I need you to hit! Wahhhh!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Why's a girl like you on the battlefield!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Don't come near, you idiot!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Hanging around there like that...\nYou're just begging to be hit!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Don't come! I'll have to shoot if you do!\n...Dammit, too late!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Hmph, were you seized by fear? How sad.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Shoot when you're shot at. It's a simple policy, no?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Gwahhhh! Why do you want war so much!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "There are people who will cry if you die, right!? So don't come here!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Why do you keep firing!? Aren't you and I both humans!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Shoot down whatever appears before you.\nThat was what I was taught as far back as I can remember.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Is this the only way...? The war won't end unless I fight...?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I told you to stop!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I don't like war! I hate it! But...!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Don't come any closer! Wahhhh!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Adults are always like this!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Was that... a girl's voice...?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You can shoot at me all you want, you still won't be able to stop me.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You're the one at fault... You shot at me first!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You fool! If you shoot, I have to shoot back!\nWhy don't you understand that!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "A d-direct hit!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Ooh~! I felt that one~!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Whoa, a direct hit!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "That's how it begins... people die, people seek revenge for them, and the cycle continues!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I said to stop shooting!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "The chain of sorrow will never end if you keep on firing!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Ugh! T-That hurt... But everyone in the world is hurting right now!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Why do fellow humans have to shoot at each other!? Why must we inflict so much pain!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Your attack has no feeling in it, it won't hurt me!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Oh, how striking. No, not your attack. You.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "That was painful... But shooting must've been just as painful for you, right!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You want a war that badly!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Everyone worked together for this peace, how could you!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "You think the war will end if you shoot me down? You're wrong!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Ah man... This is what I get for looking away.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "An arm or two isn't that important!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Dammit... The engine's hit!?",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Wounds all over... Now this is interesting!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Too bad, I'm not done yet!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I bet you thought I was down.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Dad... Mom... it huuurts...!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I won't fall here! I'll stand up... I'll stand up and go back to her!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "More! Kick me more!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Aim a bit lower!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "If your cheek gets kicked, turn the other cheek...",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "...That's one of my granduncle's lines.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "My life isn't worth much, but it's not cheap enough to let myself lose it to you!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "She told me to come back alive.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "If you're not taking this seriously, get off the battlefield!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Can I withstand this...? No, I HAVE to withstand this!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Haha, life is short, isn't it... Uwahhhhhh!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Thank you. Now I can be at her... side...",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "This makes me the 108th person you've killed!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Remember this.\nEven if you defeat me, a second, then a third kedama will take my... ",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "O-Ohhhhh!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "I... really didn't care about the war. As long as I could help her... ",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "But now... that's no longer...",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "U-Uwaahhhhh!!",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Getting kicked by a hot chick should be cherished forever...",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "...That's one of my great-grandfather's lines.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Sorry, I prefer younger women.",
"ko": ""
},
{
"kind": "dialog.Dialog",
"src": "data4/Kedama/dialog_text_Kedama_en/KedamaFMW1Text.json",
"en": "Hmph, adios.",
"ko": ""
},
{
"kind": "data.Name",
"src": "data4/data_char_all/Evileye01Char.json",
"en": "Evil Eye",
"ko": "이블아이"
},
{
"kind": "data.Name",
"src": "data4/data_char_all/FMW4Youmu01Char.json",
"en": "Youmu (FMW4)",
"ko": ""
